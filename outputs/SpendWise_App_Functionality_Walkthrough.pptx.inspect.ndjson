{"kind":"textbox","id":"sh/i10ji50j","slide":8,"text":"What changes","textPreview":"What changes","textChars":12,"textLines":1,"bbox":[922,250,210,25]}
{"kind":"textbox","id":"sh/5ob2dkzu","slide":8,"text":"Wider screens","textPreview":"Wider screens","textChars":13,"textLines":1,"bbox":[922,294,180,20]}
{"kind":"textbox","id":"sh/4321kfi9","slide":8,"text":"Home and Statistics use four summary cards in one row when the content area is wider than 620 px.","textPreview":"Home and Statistics use four summary cards in one row when the content area is wider than 620 px.","textChars":97,"textLines":1,"bbox":[922,320,210,76]}
{"kind":"textbox","id":"sh/vy9k7qhs","slide":8,"text":"Narrow screens","textPreview":"Narrow screens","textChars":14,"textLines":1,"bbox":[922,424,180,20]}
{"kind":"textbox","id":"sh/ux0je507","slide":8,"text":"The same cards become a two-column grid for comfortable reading and touch use.","textPreview":"The same cards become a two-column grid for comfortable reading and touch use.","textChars":78,"textLines":1,"bbox":[922,450,210,60]}
