{"kind":"textbox","id":"sh/lsn6dwj2","slide":8,"text":"SpendWise is one Flutter app delivered to different screens, not two separate products.","textPreview":"SpendWise is one Flutter app delivered to different screens, not two separate products.","textChars":87,"textLines":1,"bbox":[72,138,1020,32]}
